# KICK (BE 0700-AAM) SoC, board and device models.

config IMX8MM_DISPMIX
    bool

config IMX8MM_LCDIF
    bool
    select FRAMEBUFFER

config IMX8MM_MIPI_DSIM
    bool

config KICK_AD5675R
    bool
    select I2C

config KICK_DISPLAY_BENCH
    bool
    default y
    depends on AARCH64
    select IMX8MM_DISPMIX
    select IMX8MM_LCDIF
    select IMX8MM_MIPI_DSIM
    select IMX_I2C
    select SN65DSI83
    select VIVANTE_GPU

config KICK_GOODIX_GT911
    bool
    select I2C

config KICK_IMX8MM_SAI
    bool

config KICK_IMX_SDMA
    bool

config KICK_PCA9534
    bool
    select I2C

config KICK_PCF85263
    bool
    select I2C

config KICK_PERIPH_TEST
    bool
    default y
    depends on AARCH64
    select IMX_I2C
    select KICK_AD5675R
    select KICK_GOODIX_GT911
    select KICK_IMX8MM_SAI
    select KICK_IMX_SDMA
    select KICK_PCA9534
    select KICK_PCF85263

config SN65DSI83
    bool
    depends on I2C
    select IMX8MM_MIPI_DSIM

config VIVANTE_GPU
    bool
