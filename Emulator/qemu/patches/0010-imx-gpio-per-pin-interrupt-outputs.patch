diff --git a/hw/gpio/imx_gpio.c b/hw/gpio/imx_gpio.c
index 5abf208df..3752fb9f6 100644
--- a/hw/gpio/imx_gpio.c
+++ b/hw/gpio/imx_gpio.c
@@ -67,6 +67,9 @@ static void imx_gpio_update_int(IMXGPIOState *s)
     } else {
         qemu_set_irq(s->irq[0], (s->isr & s->imr) ? 1 : 0);
     }
+    for (int i = 0; i < IMX_GPIO_PIN_IRQ_COUNT; i++) {
+        qemu_set_irq(s->pin_irq[i], extract32(s->isr & s->imr, i, 1));
+    }
 }
 
 static void imx_gpio_set_int_line(IMXGPIOState *s, int line, IMXGPIOLevel level)
@@ -315,6 +318,8 @@ static void imx_gpio_realize(DeviceState *dev, Error **errp)
 
     qdev_init_gpio_in(DEVICE(s), imx_gpio_set, IMX_GPIO_PIN_COUNT);
     qdev_init_gpio_out(DEVICE(s), s->output, IMX_GPIO_PIN_COUNT);
+    qdev_init_gpio_out_named(DEVICE(s), s->pin_irq, "pin-irq",
+                             IMX_GPIO_PIN_IRQ_COUNT);
 
     sysbus_init_irq(SYS_BUS_DEVICE(dev), &s->irq[0]);
     sysbus_init_irq(SYS_BUS_DEVICE(dev), &s->irq[1]);
diff --git a/include/hw/gpio/imx_gpio.h b/include/hw/gpio/imx_gpio.h
index ae2afb3c0..823afc82a 100644
--- a/include/hw/gpio/imx_gpio.h
+++ b/include/hw/gpio/imx_gpio.h
@@ -38,6 +38,7 @@ OBJECT_DECLARE_SIMPLE_TYPE(IMXGPIOState, IMX_GPIO)
 #define ISR_ADDR            0x18 /* INTERRUPT STATUS REGISTER */
 #define EDGE_SEL_ADDR       0x1c /* EDGE SEL REGISTER */
 
+#define IMX_GPIO_PIN_IRQ_COUNT 8
 #define IMX_GPIO_PIN_COUNT 32
 
 struct IMXGPIOState {
@@ -59,6 +60,8 @@ struct IMXGPIOState {
 
     qemu_irq irq[2];
     qemu_irq output[IMX_GPIO_PIN_COUNT];
+    /* Per-pin interrupts of pins 0..7 (i.MX 8M GPIO1 INT0..INT7) */
+    qemu_irq pin_irq[IMX_GPIO_PIN_IRQ_COUNT];
 };
 
 #endif /* IMX_GPIO_H */
