{
  "run_dir": "${TMPDIR}/kickemu",
  "qemu": {
    "binary": "Emulator/out/qemu/bin/qemu-system-aarch64",
    "machine": "kick",
    "boot": "kernel",
    "accel": "auto",
    "cpu": "host",
    "tcg_cpu": "cortex-a53",
    "smp": 4,
    "memory_mb": 2048,
    "audiodev": "auto",
    "audiodev_id": "snd0",
    "audio_property": "audiodev",
    "cv_property": "cv-chardev",
    "emmc_property": "emmc",
    "sd_property": "sd",
    "boot_property": "boot-mode",
    "sdma_firmware_property": "sdma-firmware",
    "machine_properties": {},
    "serial_order": ["mcu", "uart2", "midi", "console"],
    "display": "vnc",
    "devices": [],
    "network": true,
    "ssh_host_port": 2222,
    "extra_args": []
  },
  "boot": {
    "defconfig": "Linux/buildroot/configs/KTKick_defconfig",
    "board_dir": "Linux/buildroot/board/freescale/imx8mm_var_som",
    "out_dir": "Emulator/out/boot",
    "kernel_image": "Emulator/out/boot/Image",
    "dtb": "Emulator/out/boot/imx8mm-var-som-symphony.dtb",
    "imx_boot": "Emulator/out/boot/imx-boot",
    "uboot_image": "Emulator/out/boot/u-boot.bin",
    "uboot_load_addr": "0x40200000",
    "firmware": "",
    "sdma_firmware": "",
    "cmdline": "console=ttymxc3,115200 earlycon=ec_imx6q,0x30a60000,115200 root=/dev/mmcblk2p1 rootwait rw",
    "builder": {
      "image": "kickemu-boot-builder",
      "base_image": "debian:bullseye",
      "apt_mirror": "http://archive.debian.org/debian",
      "apt_security_mirror": "http://archive.debian.org/debian-security",
      "platform": "linux/arm64",
      "volume": "kickemu-boot-build",
      "jobs": 0
    },
    "packages": {
      "gpu_module": "Linux/buildroot/package/freescale-imx/kernel-module-imx-gpu-viv",
      "imx_mkimage": "Linux/buildroot/package/imx-mkimage",
      "firmware_imx": "Linux/buildroot/package/freescale-imx/firmware-imx",
      "genimage": "Linux/buildroot/package/genimage"
    },
    "url_rewrites": {
      "git://github.com/": "https://github.com/",
      "https://source.codeaurora.org/external/imx/": "https://github.com/nxp-imx/"
    },
    "ddr_firmware_dir": "",
    "emmc": {
      "genimage_cfg": "Linux/buildroot/board/freescale/imx8mm_var_som/genimage.cfg.emmc.partiton.table",
      "rootfs_size": "",
      "rootfs_image": "Emulator/out/testimage/rootfs.ext4"
    }
  },
  "testimage": {
    "out_dir": "Emulator/out/testimage",
    "base_image": "alpine:3.22",
    "platform": "linux/arm64",
    "packages": [
      "busybox-static",
      "evtest",
      "i2c-tools",
      "alsa-utils",
      "mmc-utils",
      "memtester",
      "ethtool",
      "devmem2",
      "kmod",
      "libdrm-tests"
    ],
    "rootfs_ext4_size": "64M"
  },
  "rootfs": {
    "_comment": "Debian 12 root file system running KT_Kick on X (Emulator/rootfs/build.sh).",
    "out_dir": "Emulator/out/rootfs",
    "base_image": "debian:bookworm",
    "platform": "linux/arm64",
    "apt_mirror": "",
    "stage_container": "kickemu-rootfs-stage",
    "packages": [
      "systemd", "systemd-sysv", "systemd-resolved", "udev", "kmod", "procps",
      "iproute2", "iputils-ping", "openssh-server", "e2fsprogs",
      "alsa-utils", "i2c-tools", "evtest",
      "xserver-xorg-core", "xserver-xorg-video-fbdev", "xserver-xorg-input-evdev", "xinit",
      "libx11-6", "libxext6", "libxrandr2", "libxinerama1", "libxcursor1", "libxrender1",
      "libxi6", "libxcomposite1",
      "libasound2", "libfreetype6", "libpng16-16", "libbrotli1", "zlib1g", "libstdc++6",
      "fonts-dejavu-core", "fontconfig-config"
    ],
    "image_size": "762M",
    "label": "kick-rootfs",
    "hostname": "kick",
    "root_password": "kick",
    "ssh_authorized_keys": "",
    "console_tty": "ttymxc3",
    "console_autologin": true,
    "console_loglevel": 3,
    "board_overlay_files": [
      "etc/asound.conf",
      "usr/bin/kt_kick.sh",
      "usr/bin/kick-storage-mkfs",
      "etc/systemd/system/kick-storage-mkfs.service",
      "etc/systemd/system/media.mount",
      "etc/systemd/system/media-kickstorage.mount",
      "etc/systemd/system/local-fs.target.wants/media-kickstorage.mount",
      "etc/udev/rules.d/10-imx.rules"
    ],
    "emmc_image": "Emulator/out/images/emmc-kick-app.img",
    "x": {
      "display": ":0",
      "vt": "vt7",
      "fbdev": "/dev/fb0",
      "fb_kernel_name": "fb0",
      "touch_product": "Goodix Capacitive TouchScreen",
      "server_args": ["-nocursor", "-nolisten", "tcp", "-s", "0", "-dpms"]
    },
    "app": {
      "source": "artifact",
      "repo": "KickEm-Tools/0700-AAM",
      "ref": "main",
      "workflow": "build",
      "artifact": "KT_Kick-linux-arm64",
      "run_id": "",
      "package_file": "",
      "build_image": "debian:bookworm",
      "build_volume": "kickemu-ktkick-build",
      "build_jobs": 0,
      "build_mem_per_job_mb": 2500,
      "build_packages": [
        "ca-certificates", "git", "python3", "zstd",
        "gcc", "g++", "make", "cmake", "ninja-build", "pkg-config", "file",
        "libasound2-dev", "libjack-jackd2-dev", "libcurl4-openssl-dev", "libfreetype6-dev",
        "libx11-dev", "libxcomposite-dev", "libxcursor-dev", "libxext-dev", "libxinerama-dev",
        "libxi-dev", "libxrandr-dev", "libxrender-dev", "libglu1-mesa-dev", "mesa-common-dev",
        "libserial-dev"
      ],
      "environment": {}
    }
  },
  "storage": {
    "emmc_image": "Emulator/out/images/emmc.img",
    "emmc_size": "14G",
    "sd_image": "Emulator/out/images/sd.img",
    "sd_size": "8G",
    "test_initrd": "Emulator/out/testimage/initramfs.cpio.gz",
    "use_test_initrd": false,
    "discard": "unmap"
  },
  "panel": {
    "width": 1024,
    "height": 600
  },
  "midi": {
    "virtual_in_name": "KICK MIDI In",
    "virtual_out_name": "KICK MIDI Out"
  },
  "host": {
    "autostart": true,
    "chardev_reconnect_ms": 500,
    "sockets": {
      "mcu": "mcu.sock",
      "uart2": "uart2.sock",
      "midi": "midi.sock",
      "console": "console.sock",
      "qmp": "qmp.sock",
      "vnc": "vnc.sock",
      "cv": "cv.sock"
    },
    "ui": {
      "scale_presets": [50, 75, 100, 150],
      "default_scale": 100,
      "pixels_per_mm_at_100": 3.2,
      "presentation_background": "#0c0c0e",
      "snapshot_scale": 2.0,
      "snapshot_dir": "~/Pictures/KickEmu",
      "layout_file": "",
      "keep_screen_pixel_aspect": true,
      "led_fade_ms": 70,
      "blink_period_ms": 500,
      "log_lines": 5000,
      "terminal_scrollback": 4000,
      "terminal_font_size": 12.0
    },
    "mcu": {
      "frame_trailer": [10],
      "tx_frame_gap_us": 0,
      "led_radio_groups": [[0, 1, 2, 3, 4, 5, 6, 7], [44, 45, 46]],
      "comm_init_interval_ms": 1000,
      "keepalive_interval_ms": 2000,
      "sw_version": [1, 0],
      "button_led_colour": "fixed",
      "jog_ring_default": "connected",
      "shift_alternates": true,
      "long_press_ms": 0,
      "pad_velocity_min": 24,
      "pad_velocity_max": 127,
      "aftertouch_interval_ms": 30,
      "aftertouch_state": 2,
      "encoder_drag_px_per_step": 6,
      "jog_drag_degrees_per_step": 15,
      "wheel_steps_per_notch": 1,
      "slider_leds": 16
    },
    "touch": {
      "max_contacts": 5,
      "abs_max": 32767,
      "send_abs": true,
      "pinch_modifier": "alt"
    },
    "connect_retry_ms": 300,
    "qemu_quit_timeout_ms": 3000,
    "cv": {
      "channels": 8,
      "full_scale_volts": 5.0,
      "adc_max": 4095
    },
    "pad_palette": [
      "#94172E", "#7C00F8", "#AB7B00", "#1DF800", "#E4F800", "#22AB00",
      "#0DF0FF", "#3DAEFF", "#0D34FF", "#FF00E9", "#CC00FF", "#FF89FA",
      "#FF250D", "#FF730D", "#FFB608", "#000000", "#FFFFFF", "#C2C2C2"
    ],
    "keyboard": {
      "shift": "SHIFT"
    }
  },
  "profiles": {
    "demo": {
      "_comment": "Bare-metal showcase firmware (Emulator/demo/baremetal) on the kick machine: screen animation and the PktMgr light show on the front panel.",
      "boot": {
        "kernel_image": "Emulator/out/demo/kick-demo.elf",
        "dtb": "",
        "cmdline": ""
      },
      "storage": { "use_test_initrd": false }
    },
    "selftest": {
      "_comment": "Vendor kernel with the Alpine test initramfs; runs kick-selftest on the console after boot.",
      "boot": {
        "cmdline": "console=ttymxc3,115200 earlycon=ec_imx6q,0x30a60000,115200 kick.selftest=1"
      },
      "storage": { "use_test_initrd": true }
    },
    "kick-app": {
      "_comment": "Vendor kernel with the Debian 12 rootfs from Emulator/rootfs/build.sh on the eMMC (partition 1, root=/dev/mmcblk2p1): X on fb0 and KT_Kick, MCU on ttymxc0.",
      "boot": {
        "cmdline": "console=ttymxc3,115200 earlycon=ec_imx6q,0x30a60000,115200 root=/dev/mmcblk2p1 rootwait rw"
      },
      "storage": {
        "emmc_image": "Emulator/out/images/emmc-kick-app.img",
        "use_test_initrd": false
      }
    },
    "virt-test": {
      "_comment": "Stock QEMU virt machine with virtio GPU and multitouch, for testing the display, touch and QMP path before the kick machine is ready.",
      "qemu": {
        "binary": "/opt/homebrew/bin/qemu-system-aarch64",
        "machine": "virt",
        "boot": "firmware",
        "cpu": "host",
        "smp": 2,
        "memory_mb": 1024,
        "audiodev": "",
        "cv_property": "",
        "emmc_property": "",
        "sd_property": "",
        "serial_order": ["console"],
        "devices": ["virtio-gpu-pci,xres=1024,yres=600", "virtio-multitouch-pci", "virtio-keyboard-pci"],
        "network": false
      },
      "host": {
        "touch": { "send_abs": false }
      },
      "boot": {
        "firmware": "/opt/homebrew/share/qemu/edk2-aarch64-code.fd"
      }
    }
  }
}
